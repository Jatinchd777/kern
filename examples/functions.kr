fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn main() {
    let result = add(10, 20);
    print(result);

    let mut i: i32 = 1;
    while i <= 5 {
        print(factorial(i));
        i = i + 1;
    }
}
