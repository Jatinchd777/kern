struct User {
    name: String,
    age: u32,
}

struct Point {
    x: i32,
    y: i32,
}

fn distance_squared(a: Point, b: Point) -> i32 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    return dx * dx + dy * dy;
}

fn main() {
    let user = User {
        name: "Jatin",
        age: 15,
    };
    print(user.name);
    print(user.age);

    let origin = Point { x: 0, y: 0 };
    let p = Point { x: 3, y: 4 };
    print(distance_squared(origin, p));
}
